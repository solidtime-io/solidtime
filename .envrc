# tock dev environment (direnv). `direnv allow` once per checkout.
export TOCK_ADDR=:8080
export TOCK_APP_URL=http://localhost:8080
export TOCK_DB_DSN=postgres://tock:tock@127.0.0.1:54329/tock?sslmode=disable
export TOCK_TEST_DSN=postgres://tock:tock@127.0.0.1:54330/tock_test?sslmode=disable
export TOCK_GOTENBERG_URL=http://127.0.0.1:3100
# PHP composer vendor/ would trigger Go vendor mode — disable until Phase 9.
export GOFLAGS=-mod=mod
