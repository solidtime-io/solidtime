# Copy to .env.selfhost-test and fill in the Google credentials.
APP_KEY=
APP_URL=http://localhost:8085
APP_FORCE_HTTPS=false
APP_DEBUG=false
APP_ENABLE_REGISTRATION=true

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ldtime
DB_USERNAME=ldtime
DB_PASSWORD=ldtime

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_DRIVER=file
MAIL_MAILER=log

# Google SSO + Calendar — use the same OAuth client as production, with
# http://localhost:8085/auth/google/callback and
# http://localhost:8085/settings/google-calendar/callback added as redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SSO_ENABLED=true
GOOGLE_SSO_ALLOWED_DOMAINS=
GOOGLE_SSO_AUTO_PROVISION=true
SUPER_ADMINS=
